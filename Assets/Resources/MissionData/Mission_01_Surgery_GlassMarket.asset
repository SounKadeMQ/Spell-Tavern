  m_Name: Mission_01_Surgery_GlassMarket
  m_EditorClassIdentifier: Assembly-CSharp::MissionData
  missionId: ch1_surgery_01
  displayName: Young Adventurer
  episodeCode: 1-1
  episodeOrder: 1
  chapterLabel: Chapter 1
  kind: 0
  patientData: {fileID: 11400000, guid: d76f5b62e52517145b650e24ea3e9016, type: 2}
  missionSummary: Annie has two simple outside cuts. This first operation teaches
    spell selection, clean Fire casts, and basic wound targeting.
  sceneName: preOpScene
  surgeryMusicResource: Audio/Music/NormalSurgery
  nextMissionId: ch1_surgery_02
  unlockedByDefault: 0
  preOpLines:
  - speaker: Nurse Rina
    text: 'We have your first living patient coming in now. '
  - speaker: Nurse Rina
    text: Her name is Annie and she is an aspiring young adventurer.
  - speaker: Annie
    text: Hi, I've just been scratched up a bit after my first adventure fighting
      some beasts in the nearby plains.
  - speaker: Annie
    text: 'I was planning to go to the church to get this taken care of but found
      out the prices for a basic treatment was more than what I was able to earn
      today. '
  - speaker: Player
    text: 'You''ve come to the right place at the right time, we just opened up this
      infirmary at the tavern today so don''t worry about the price for the treatment.  '
  - speaker: Player
    text: Grab some food after you get treated and I'll consider your debt for this
      treatment paid.
  - speaker: 'Nurse Rina '
    text: 'I''ve got the components ready, lets get this treatment started now. '
  surgeryLines:
  - speaker: Angie
    text: I can feel the stinging sensation from the cuts. Could you please make
      this quick.
    waitForSpellSelect: 0
    waitForSpellCast: 0
    waitForWoundsCleared: 0
    waitBeforeShowingLine: 0
    transitionToInside: 0
    transitionToPart: 0
    focusSpawnAreaId: 
    activateSpawnAreaId: 
    triggerEmergencyTimeDilation: 0
    triggerEmergencyImpact: 0
    missionCompleteFlag: 0
    requiredSpell: 0
    requiredWoundLocation: 0
    requiredSpawnAreaId: 
  - speaker: Nurse Rina
    text: 'Let''s cast the Water spell first to top up the blood of our patient.

      Select
      the Water spell on the bottom left of the screen.'
    waitForSpellSelect: 1
    waitForSpellCast: 0
    waitForWoundsCleared: 0
    waitBeforeShowingLine: 0
    transitionToInside: 0
    transitionToPart: 0
    focusSpawnAreaId: 
    activateSpawnAreaId: 
    triggerEmergencyTimeDilation: 0
    triggerEmergencyImpact: 0
    missionCompleteFlag: 0
    requiredSpell: 1
    requiredWoundLocation: 0
    requiredSpawnAreaId: 
  - speaker: Nurse Rina
    text: Great! Now just follow the rune, and cast the spell.
    waitForSpellSelect: 0
    waitForSpellCast: 1
    waitForWoundsCleared: 0
    waitBeforeShowingLine: 0
    transitionToInside: 0
    transitionToPart: 0
    focusSpawnAreaId: 
    activateSpawnAreaId: 
    triggerEmergencyTimeDilation: 0
    triggerEmergencyImpact: 0
    missionCompleteFlag: 0
    requiredSpell: 1
    requiredWoundLocation: 0
    requiredSpawnAreaId: 
  - speaker: Nurse Rina
    text: Great work! Let's deal with the cuts now.
    waitForSpellSelect: 0
    waitForSpellCast: 0
    waitForWoundsCleared: 0
    waitBeforeShowingLine: 0
    transitionToInside: 0
    transitionToPart: 0
    focusSpawnAreaId: 
    activateSpawnAreaId: 
    triggerEmergencyTimeDilation: 0
    triggerEmergencyImpact: 0
    missionCompleteFlag: 0
    requiredSpell: 0
    requiredWoundLocation: 0
    requiredSpawnAreaId: 
  - speaker: Nurse Rina
    text: ' This is an shallow wound, so keep the work clean and direct with a Fire
      Spell.

      Select the Fire spell on the bottom left of the screen.'
    waitForSpellSelect: 1
    waitForSpellCast: 0
    waitForWoundsCleared: 0
    waitBeforeShowingLine: 0
    transitionToInside: 0
    transitionToPart: 0
    focusSpawnAreaId: 
    activateSpawnAreaId: 
    triggerEmergencyTimeDilation: 0
    triggerEmergencyImpact: 0
    missionCompleteFlag: 0
    requiredSpell: 5
    requiredWoundLocation: 0
    requiredSpawnAreaId: 
  - speaker: Nurse
    text: Close both shallow wounds with the Fire spell.
    waitForSpellSelect: 0
    waitForSpellCast: 0
    waitForWoundsCleared: 1
    waitBeforeShowingLine: 0
    transitionToInside: 0
    transitionToPart: 0
    focusSpawnAreaId: 
    activateSpawnAreaId: 
    triggerEmergencyTimeDilation: 0
    triggerEmergencyImpact: 0
    missionCompleteFlag: 0
    requiredSpell: 5
    requiredWoundLocation: 0
    requiredSpawnAreaId: 
  - speaker: Angie
    text: 'Thank you so much. '
    waitForSpellSelect: 0
    waitForSpellCast: 0
    waitForWoundsCleared: 0
    waitBeforeShowingLine: 0
    transitionToInside: 0
    transitionToPart: 0
    focusSpawnAreaId: 
