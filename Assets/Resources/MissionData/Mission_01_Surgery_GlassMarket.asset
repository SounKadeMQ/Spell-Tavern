  preOpLines:
  - speaker: Nurse
    text: 'First patient of the night: Angie. Two outside cuts, steady pulse.'
  - speaker: Nurse
    text: Keep her calm, trace the Fire rune cleanly, and do not waste Water unless
      her blood drops.
  surgeryLines:
  - speaker: Angie
    text: I can feel the cut pulsing. Please make it quick.
    waitForSpellSelect: 0
    waitForSpellCast: 0
    waitForWoundsCleared: 0
